#!/usr/bin/env python3
"""xv — verified examples: docs an agent can check instead of recall.

Producer (CI):   xv run   [-m examples/manifest.json] [-o examples/attest.json]
Consumer (agent): xv check [-m ...] [-a ...] [--rerun] [--strict]
Discovery:        xv llms  -> the stanza to paste into llms.txt

manifest.json:
{ "package": "rv", "version_cmd": "git rev-parse --short HEAD",
  "examples": [ { "id": "quickstart", "path": "examples/quickstart.sh",
                  "command": "bash examples/quickstart.sh" } ] }

Each example becomes one in-toto Statement: subject = the example file by digest,
predicate = what ran, against which version, exit code, stdout digest + tail, when.
`check` answers, per example: VERIFIED (attested, unchanged, same version)
/ MODIFIED (example bytes changed) / STALE (installed version != attested)
/ FAILED (--rerun: exit or output differs) / MISSING. stdlib only.
"""
import hashlib, json, os, platform, subprocess, sys, time

PRED = "https://github.com/DrVelvetFog/verified-examples/v0"


def sha(b): return hashlib.sha256(b).hexdigest()
def sha_file(p): return sha(open(p, "rb").read())
def now(): return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def run(cmd, cwd):
    r = subprocess.run(cmd, shell=True, cwd=cwd, capture_output=True, text=True)
    return r.returncode, r.stdout


def version(man, root):
    vc = man.get("version_cmd")
    if not vc:
        return man.get("version", "unknown")
    rc, out = run(vc, root)
    return out.strip() if rc == 0 else "unknown"


def cmd_run(man, root, out_path):
    ver = version(man, root)
    stmts = []
    for ex in man["examples"]:
        p = os.path.join(root, ex["path"])
        rc, out = run(ex["command"], root)
        stmts.append({
            "_type": "https://in-toto.io/Statement/v1",
            "subject": [{"name": ex["path"], "digest": {"sha256": sha_file(p)}}],
            "predicateType": PRED,
            "predicate": {
                "id": ex["id"], "package": man.get("package"), "version": ver,
                "command": ex["command"], "exit": rc,
                "stdout": {"sha256": sha(out.encode()), "bytes": len(out.encode()), "tail": out[-200:]},
                "ran_at": now(),
                "runner": {"os": platform.system().lower(), "python": platform.python_version(),
                           "ci": os.environ.get("GITHUB_ACTIONS") == "true"},
            }})
        print(f"{'ok  ' if rc == 0 else 'FAIL'} {ex['id']:<20} exit={rc} v={ver}")
    json.dump({"schema": "verified-examples/v0", "attestations": stmts}, open(out_path, "w"), indent=1)
    print(f"wrote {out_path} ({len(stmts)} attestations)")
    return all(s["predicate"]["exit"] == 0 for s in stmts)


def cmd_check(man, root, att_path, rerun=False):
    if not os.path.exists(att_path):
        print(f"no attestations at {att_path} — examples are prose (told), not verified"); return False
    atts = {a["predicate"]["id"]: a for a in json.load(open(att_path))["attestations"]}
    ver = version(man, root)
    ok_all = True
    for ex in man["examples"]:
        a = atts.get(ex["id"]); p = os.path.join(root, ex["path"])
        if not a:
            status, why = "MISSING", "no attestation"; ok_all = False
        elif not os.path.exists(p) or a["subject"][0]["digest"]["sha256"] != sha_file(p):
            status, why = "MODIFIED", "example bytes differ from attested"; ok_all = False
        elif a["predicate"]["version"] != ver:
            status, why = "STALE", f"attested v={a['predicate']['version']} installed v={ver}"; ok_all = False
        elif a["predicate"]["exit"] != 0:
            status, why = "FAILED", f"attested exit={a['predicate']['exit']}"; ok_all = False
        elif rerun:
            rc, out = run(ex["command"], root)
            same = rc == a["predicate"]["exit"] and sha(out.encode()) == a["predicate"]["stdout"]["sha256"]
            status = "VERIFIED" if same else "FAILED"
            why = "re-ran: exit+output match attestation" if same else f"re-ran: exit={rc}, output differs"
            ok_all &= same
        else:
            status, why = "VERIFIED", f"attested {a['predicate']['ran_at']} v={ver}"
        print(f"{status:<9} {ex['id']:<20} {why}")
    print("ALL VERIFIED" if ok_all else "NOT ALL VERIFIED — treat unverified examples as prose")
    return ok_all


def cmd_llms(man, att_rel, man_rel):
    print(f"""## Verified examples

- [manifest]({man_rel}): runnable examples for {man.get('package','this package')}
- [attestations]({att_rel}): in-toto Statements — which version each example last ran against, exit code, output digest
- Check before use: `xv check --rerun` (https://github.com/DrVelvetFog/verified-examples)""")


def main():
    a = sys.argv[1:]
    if not a or a[0] in ("-h", "--help"):
        print(__doc__); return
    def opt(flag, default):
        return a[a.index(flag) + 1] if flag in a else default
    man_path = opt("-m", "examples/manifest.json"); att_path = opt("-a", opt("-o", "examples/attest.json"))
    root = os.getcwd()
    man = json.load(open(man_path))
    if a[0] == "run":
        sys.exit(0 if cmd_run(man, root, att_path) else 1)
    if a[0] == "check":
        ok = cmd_check(man, root, att_path, rerun="--rerun" in a)
        sys.exit(0 if ok or "--strict" not in a else 1)
    if a[0] == "llms":
        cmd_llms(man, att_path, man_path); return
    sys.exit(f"xv: unknown command {a[0]}")


if __name__ == "__main__":
    main()
